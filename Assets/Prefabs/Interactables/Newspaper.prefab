  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'At the start of a shift, the callers for that day will populate the phone
    queue.



    The Yellow lights on the top of the unit indicate a caller waiting
    on hold.


    Picking up the phone will answer the call in the next queue position.


    Clicking
    the phone while in a call will hang up.


    Caution: Once a caller disconnects
    they can never be reached again!'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 61064fa2516a0e944933044735159339, type: 2}
